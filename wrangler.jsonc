{
  // Cloudflare Workers config for Strange Is the Night.
  // Deploy with: npx wrangler deploy   (see README.md for the friendly guide)
  "name": "strange-is-the-night",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  // The game's home. Deploying auto-attaches these domains — they just need
  // to exist as a zone in the same Cloudflare account first.
  "routes": [
    { "pattern": "strangeisthenight.party", "custom_domain": true },
    { "pattern": "www.strangeisthenight.party", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
